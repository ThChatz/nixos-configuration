{pkgs, lib,...} : {
  services.autorandr.enable = true;

  # add autrandr executable to path
  environment.systemPackages = lib.mkAfter (with pkgs; [
    autorandr
  ]);

  

  # profiles
  services.autorandr.profiles = {
    "lg-ultrawide" = {
      fingerprint = {
        "DP-0" = "";
        "HDMI-0" = "";
      };
      config = {
        "HDMI-0" = {
          enable = true;
          crtc = 0;
          mode = "3440x1440";
          position = "0x0";
          primary = true;
          rate = "100.00";
        };
        # disable other outputs
        "DP-0".enable = false;
        "DP-1".enable = false;
        "DP-2".enable = false;
        "DP-3".enable = false;
        "DP-4".enable = false;
        "DP-5".enable = false;
      };
    };
    "lg-ultrawide-split" = {
      fingerprint = {
        "DP-0" = "";
        "HDMI-0" = "";
      };
      config = {
        "HDMI-0" = {
          enable = true;
          crtc = 0;
          mode = "1720x1440";
          position = "0x0";
          primary = true;
          rate = "59.92";
        };
        
        "DP-0" = {
          enable = true;
          crtc = 0;
          mode = "1720x1440";
          position = "1720x0";
          primary = false;
          rate = "59.92";
        };
        
        "DP-1".enable = false;
        "DP-2".enable = false;
        "DP-3".enable = false;
        "DP-4".enable = false;
        "DP-5".enable = false;
      };
    };
  };

  services.autorandr.hooks.postswitch = {
    change-background = ''
    case $AUTORANDR_CURRENT_PROFILE in
    "lg-ultrawide")
      feh --bg-scale ${../../assets/wallpapers/3440x1440/mignon.png}
    esac;
    '';
  };
}
